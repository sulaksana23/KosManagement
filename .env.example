DATABASE_URL=postgresql://kosmanager:kosmanager@localhost:5432/kosmanager
# URL koneksi langsung Neon untuk migration; bila kosong, db:migrate memakai DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://...
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_FROM_OPENSSL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin tambahan untuk auth bila aplikasi memakai beberapa domain (pisahkan dengan koma).
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com,https://preview.example.com

# Opsional: reset kata sandi dan undangan dikirim melalui Resend.
# Buat API key di Resend dan verifikasi domain pengirim sebelum mengaktifkan.
RESEND_API_KEY=
EMAIL_FROM=

# Rahasia untuk endpoint pengingat yang dipanggil Vercel Cron.
# Buat dengan: openssl rand -hex 32
CRON_SECRET=

# Email admin platform untuk meninjau permintaan upgrade Pro (pisahkan beberapa email dengan koma).
# KOSMANAGER_ADMIN_EMAILS=admin@example.com

# Opsional untuk membuat akun + data contoh development. Jangan isi data nyata.
# SEED_OWNER_EMAIL=demo@example.com
# SEED_OWNER_PASSWORD=change-this-demo-password
